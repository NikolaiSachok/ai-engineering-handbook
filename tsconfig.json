// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TypeScript 7 removed baseUrl, which @docusaurus/tsconfig still sets; unset it and
    // redeclare the "@site/*" mapping here, since without baseUrl an inherited path
    // resolves relative to the base config inside node_modules.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    },
    "strict": true
  },
  "exclude": [".docusaurus", "build", "e2e"]
}
